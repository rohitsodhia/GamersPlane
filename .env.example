COMPOSE_PROJECT_NAME=gamersplane

ENVIRONMENT=
TZ=
HOST_NAME=
API_HOST_NAME=
VITE_API_BASE_URL=
COOKIE_DOMAIN=
ROOT_DIR=
API_SERVER_NAMES=

JWT_ALGORITHM=
JWT_SECRET_KEY=
PVAR=

PAGINATE_PER_PAGE=20
VITE_PAGINATE_PER_PAGE=20

DATABASE_DIALECT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_DATABASE=gamersplane
DATABASE_USER=gamersplane
DATABASE_PASSWORD=
DATABASE_SSH_USERNAME=

CACHE_HOST=redis://cache:6379/0
CACHE_TTL=86400

# Hostname of the SMTP relay (compose service name when using ./compose.sh --email)
EMAIL_HOST=postfix
EMAIL_PORT=25
# Whether the API actually sends mail. Defaults to true unless ENVIRONMENT=dev (dev just logs the message).
# Set to true in dev to test real sending (needs ./compose.sh --email)
# EMAIL_ENABLED=true
# Inbox that receives Contact Us form submissions (defaults to contact@gamersplane.com)
# CONTACT_EMAIL=contact@gamersplane.com

# Host path (relative to repo root) of the DKIM private key; mounted read-only into the opendkim container
# e.g. ./docker/opendkim/keys/gamersplane.com/<selector>.private
OPENDKIM_KEY=
# DKIM selector matching the DNS TXT record <selector>._domainkey.<domain>, e.g. 20240315
OPENDKIM_SELECTOR=
# Sending domain: postfix myhostname AND the opendkim signing Domain. Must equal the domain of the
# From address, or mail goes out unsigned (e.g. gamersplane.com or staging.gamersplane.com)
POSTFIX_MYHOSTNAME=
